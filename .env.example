# Base URL of the Raut backend API (no trailing slash).
# The auth endpoint lives directly under it: {base}/auth/login
# Example: NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_* values are inlined at build time, so rebuild after changing this.
NEXT_PUBLIC_API_BASE_URL=

# Comma-separated roles that grant dashboard access.
# Example: NEXT_PUBLIC_ADMIN_ROLES=admin,super_admin
NEXT_PUBLIC_ADMIN_ROLES=

# Base URL used to build referral signup links: {base}?ref=CODE
# Defaults to https://raut.app/signup when omitted. Inlined at build time.
NEXT_PUBLIC_REFERRAL_BASE_URL=https://raut.app/signup

# Serve built-in sample promotions while the promotions API is unavailable.
# Defaults to true when omitted. Set to false once the backend endpoints are ready.
NEXT_PUBLIC_USE_MOCK_MARKETING=true

# Serve built-in sample admin users while the admin users API is unavailable.
# Defaults to true when omitted. Set to false once the backend endpoints are ready.
NEXT_PUBLIC_USE_MOCK_ADMIN_USERS=true
